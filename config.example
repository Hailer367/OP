# OP config: KEY=VALUE, one per line, no quotes. Copy to ~/.config/op/config
# Anything here can also be set in the environment.

# auto | warp | tor | proxy | exec | none
EGRESS=auto

# install Cloudflare WARP on first run when it is missing (needs root or sudo)
AUTO_INSTALL=1

# path to the opencode binary (a .js path is run with node)
OC=opencode

# url or file, any text: every ip:port in it is a proxy candidate
PROXY_LIST=

# attempts per limit, and how long a new route may take to answer
ROTATE_TRIES=8
ROUTE_WAIT=15
ROTATE_COOLDOWN=2

# stop instead of rotating forever: N rotations per WINDOW seconds
ROTATE_GATE_MAX=5
ROTATE_GATE_WINDOW=1800

# prove the new IP with a throwaway session before resuming
PROBE=1
PROBE_TIMEOUT=120

# what the resumed turn is nudged with
RESUME_MSG=continue
RESUME_TIMEOUT=180

# ask before rotating (0 = rotate by itself)
ASK=0

# what counts as a limit in the opencode log (three classes, noop wins)
PAT_ROTATE=free-limit|free usage|usage limit|out of usage|insufficient credits|payment required|quota exceeded|limit reached
PAT_ASK=rate limit|too many requests|429
PAT_NOOP=compact|compaction|context length|context window|maximum context|invalid model|model not found

# seconds between unattended rate-limit rotations
ASK_COOLDOWN=600

# continue | last | custom
RESUME_MODE=continue
RESUME_TEXT=

# cap the activity log
LOG_MAX_KB=1024
